{
  "name": "node-td",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "internal/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "clean": "git clean -xdf node_modules .turbo .cache"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.9",
    "turbo": "2.8.21",
    "typescript": "5.9.3"
  },
  "packageManager": "bun@1.3.9"
}
